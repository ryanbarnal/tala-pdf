{
  "name": "tala-pdf",
  "version": "0.1.0",
  "description": "Read, mark up, sign and edit PDFs on your own device.",
  "main": "electron/main.cjs",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && vite build",
    "build:desktop": "npm run assets && vite build --mode desktop",
    "preview": "vite preview",
    "desktop": "npm run build:desktop && electron .",
    "dist": "npm run build:desktop && electron-builder --publish never",
    "test": "node tests/make-fixture.mjs && node tests/smoke.cjs",
    "test:desktop": "node tests/make-fixture.mjs && node tests/desktop.cjs"
  },
  "author": "Tala PDF",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "lucide": "^1.72.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "productName": "Tala PDF",
  "private": true,
  "type": "module",
  "build": {
    "appId": "app.talapdf.desktop",
    "productName": "Tala PDF",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "artifactName": "Tala-PDF-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanbarnal/tala-pdf.git"
  }
}
